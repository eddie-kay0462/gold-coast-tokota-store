# Laravel API base. Both frontend apps point at the same versioned prefix.
NUXT_PUBLIC_API_BASE=http://localhost:8000/api/v1

# Data source while the admin API is still being built.
#   auto     — try the real endpoint, fall back to bundled fixtures (default)
#   live     — real API only
#   fixtures — never call the API
NUXT_PUBLIC_ADMIN_DATA=auto
