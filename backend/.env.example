APP_NAME="Gold Coast Tokota"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
# Production (Neon): set DB_URL to the *pooled* connection string and
# DB_DIRECT_URL to the direct one (migrations only — see docs/deploy/neon.md),
# with DB_SSLMODE=require. Locally, the DB_HOST.. values below are used.
# DB_URL=
# DB_DIRECT_URL=
# DB_SSLMODE=require
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=gold_coast_tokota
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost

# First-party Nuxt SPA origins — must match exactly for cookie-based Sanctum
# auth (see config/cors.php supports_credentials + config/sanctum.php).
# Two separate Nuxt apps call this API: ../frontend (storefront) and
# ../admin (dashboard).
FRONTEND_URLS=http://localhost:3000,http://localhost:3001
SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost:3001

# Proxies whose X-Forwarded-* headers are believed (config/trustedproxy.php).
# Empty locally. Production: the private ranges, since only the stack's own
# nginx can reach PHP-FPM (docs/deploy/contabo.md).
TRUSTED_PROXIES=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Where uploaded images live (App\Support\MediaStorage). `public` locally;
# production uses Cloudflare R2 — MEDIA_DISK=r2, PRIVATE_MEDIA_DISK=r2-private
# and the R2_* values below. See docs/deploy/contabo.md §7.
MEDIA_DISK=public
PRIVATE_MEDIA_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@goldcoasttokota.store"
MAIL_FROM_NAME="${APP_NAME}"

# Cloudflare R2 (S3-compatible; no AWS account involved). Production only.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
R2_PRIVATE_BUCKET=

# Live GHS->USD rate provider (see README Clarifications Needed #2 — resolved
# to exchangerate.host). Free tier requires an access_key from
# https://exchangerate.host; RefreshFxRate runs hourly (routes/console.php).
EXCHANGERATE_HOST_URL=https://api.exchangerate.host
EXCHANGERATE_HOST_KEY=

# Payments. The brand document (§13, §22.12) names Paystack as *the* gateway,
# settling in GHS — both currencies route to it. Webhooks are signed with the
# secret key itself; PAYSTACK_WEBHOOK_SECRET is only for deployments that
# rotate a separate value in. Point the webhook at
# POST {API}/api/v1/webhooks/paystack in the Paystack dashboard.
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# Where Paystack returns the customer after payment. Defaults to the first
# entry in FRONTEND_URLS, which is the storefront by convention.
STOREFRONT_URL=http://localhost:3000

# Shared secret the storefront's server sends as X-Storefront-Key, so its
# requests are rate-limited per visitor instead of all sharing Vercel's
# address. Same value as NUXT_STOREFRONT_API_KEY on the storefront's Vercel
# project. Generate with: openssl rand -hex 32
STOREFRONT_API_KEY=

# WhatsApp Business Platform (Cloud API), for the admin inbox and Order on
# WhatsApp — see config/whatsapp.php. Empty means LogWhatsAppClient: the inbox
# works and nothing is sent. The number is connected with coexistence through
# Meta's Embedded Signup, so the phone app keeps working. Point the webhook at
# {API}/api/v1/webhooks/whatsapp in the Meta app (fields: messages,
# smb_message_echoes, history, smb_app_state_sync,
# message_template_status_update), with WHATSAPP_VERIFY_TOKEN as its token.
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Rehearsal only: record raw webhook bodies to storage/logs/whatsapp-payloads.log.
# They contain customers' numbers and messages. Leave false in production.
WHATSAPP_LOG_PAYLOADS=false

# Unrouted — see config/services.php. The README paired Stripe with USD; the
# brand document does not mention it, and PaymentGatewayFactory no longer
# resolves to it. Kept so the settings panel keeps reporting honestly.
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Shipping (config/shipping.php). Zones: ACCRA (pin inside the polygon set in
# admin), GHANA (flat regional rates set in admin), INTERNATIONAL. Courier
# drivers arrive in later phases; until one is enabled every zone is priced at
# the rates below and dispatched by hand.
#
# Where couriers collect from. Yango needs the coordinates.
SHIPPING_ORIGIN_NAME="Gold Coast Tokota"
SHIPPING_ORIGIN_PHONE=
SHIPPING_ORIGIN_EMAIL=
SHIPPING_ORIGIN_ADDRESS=
SHIPPING_ORIGIN_CITY=Accra
SHIPPING_ORIGIN_LAT=
SHIPPING_ORIGIN_LNG=
# Added to live courier quotes, which are booked up to 48h after payment.
SHIPPING_QUOTE_BUFFER_PERCENT=10
# Seconds a checkout quote is honoured.
SHIPPING_QUOTE_TTL=900
# GHS minor units, charged when a zone has no live courier or its quote fails.
# Defaults are the static rates checkout charged before zones existed.
SHIPPING_FALLBACK_ACCRA_GHS=3500
SHIPPING_FALLBACK_GHANA_GHS=3500
SHIPPING_FALLBACK_INTERNATIONAL_GHS=35000
# A Ghana region with no rate set in admin: 'fallback' charges the Ghana rate
# above; 'refuse' sends the customer to WhatsApp.
SHIPPING_UNPRICED_REGIONS=fallback
# Who is told about orders to dispatch by hand and deliveries that failed.
OPS_ALERT_EMAIL=
OPS_ALERT_PHONE=
SHIPPING_STALE_PENDING_HOURS=48
# The admin dashboard, for links in those alerts. Defaults to the second
# entry in FRONTEND_URLS.
ADMIN_URL=http://localhost:3001

# Queue for courier booking and polling jobs. Set to `shipping` once the
# worker runs `--queue=shipping,default` (docs/deploy/contabo.md).
SHIPPING_QUEUE=default

# Yango Delivery, the Accra zone's courier. The token comes from the Yango
# business cabinet, Integration tab. Off until YANGO_ENABLED=true. With it on
# and no key, local development uses a fake Yango; production skips Yango.
# Claims are only ever ACCEPTED (a real courier booked) when APP_ENV=production.
YANGO_ENABLED=false
YANGO_API_KEY=
YANGO_API_BASE_URL=https://b2b.delivery.yango.tech
YANGO_TAXI_CLASS=courier
YANGO_CONFIRM_POLL_SECONDS=30
YANGO_POLL_SECONDS=60
YANGO_COURIER_TIMEOUT_MINUTES=15

# DHL Express (MyDHL API), the International zone's courier. Credentials come
# from a DHL Express account consultant. Defaults to DHL's test environment
# (500 calls a day, no real shipments); switch DHL_API_BASE_URL to
# https://express.api.dhl.com/mydhlapi for production. With DHL_ENABLED=true
# and no credentials, local development uses a fake DHL; production skips it.
# While on, international checkout refuses products with no weight, size or
# HS code (set them on the admin product page).
DHL_ENABLED=false
DHL_API_USERNAME=
DHL_API_PASSWORD=
DHL_ACCOUNT_NUMBER=
DHL_API_BASE_URL=https://express.api.dhl.com/mydhlapi/test
DHL_API_VERSION=3.3.1
DHL_POLL_MINUTES=60
# Comma-separated DHL product codes to offer (e.g. P). Empty offers all quoted.
DHL_PRODUCTS=
DHL_REQUEST_PICKUP=true
DHL_PICKUP_CLOSE_TIME=17:00
DHL_PICKUP_LOCATION=reception
# Show an estimate of import duties at checkout (never charged; DAP). Leave off
# until the landed-cost response has been checked against the test API.
SHIPPING_DHL_LANDED_COST=false
# The shipper's postcode, if the pickup address has one.
SHIPPING_ORIGIN_POSTCODE=

# Feature 8 SMS. **Without these the SMS half falls back to LogSmsChannel**,
# which writes each message to the log instead of sending it — the feature
# still runs end to end, it just does not text anyone, and the admin
# notifications panel reports `sms_channel: log_only` rather than implying
# otherwise. Email needs no credential in development: MAIL_MAILER=log above
# renders the real template to the log.
# The request shape in FishAfricaSmsService is written from the README's
# description and has never been run against the live API — expect to correct
# it when keys land, and sandbox-test first (Ghana delivery rates unverified).
FISH_AFRICA_APP_ID=
FISH_AFRICA_APP_SECRET=
FISH_AFRICA_BASE_URL=https://api.letsfish.africa

GA4_MEASUREMENT_ID=
GA4_API_SECRET=

VITE_APP_NAME="${APP_NAME}"
