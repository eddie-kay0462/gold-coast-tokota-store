APP_NAME="Gold Coast Tokota"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
# Production (Neon): set DB_URL to the *pooled* connection string and
# DB_DIRECT_URL to the direct one (migrations only — see docs/deploy/neon.md),
# with DB_SSLMODE=require. Locally, the DB_HOST.. values below are used.
# DB_URL=
# DB_DIRECT_URL=
# DB_SSLMODE=require
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=gold_coast_tokota
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost

# First-party Nuxt SPA origins — must match exactly for cookie-based Sanctum
# auth (see config/cors.php supports_credentials + config/sanctum.php).
# Two separate Nuxt apps call this API: ../frontend (storefront) and
# ../admin (dashboard).
FRONTEND_URLS=http://localhost:3000,http://localhost:3001
SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost:3001

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Where uploaded images live (App\Support\MediaStorage). `public` locally;
# production uses Cloudflare R2 — MEDIA_DISK=r2, PRIVATE_MEDIA_DISK=r2-private
# and the R2_* values below. See docs/deploy/contabo.md §7.
MEDIA_DISK=public
PRIVATE_MEDIA_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@goldcoasttokota.store"
MAIL_FROM_NAME="${APP_NAME}"

# Cloudflare R2 (S3-compatible; no AWS account involved). Production only.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
R2_PRIVATE_BUCKET=

# Live GHS->USD rate provider (see README Clarifications Needed #2 — resolved
# to exchangerate.host). Free tier requires an access_key from
# https://exchangerate.host; RefreshFxRate runs hourly (routes/console.php).
EXCHANGERATE_HOST_URL=https://api.exchangerate.host
EXCHANGERATE_HOST_KEY=

# Payments. The brand document (§13, §22.12) names Paystack as *the* gateway,
# settling in GHS — both currencies route to it. Webhooks are signed with the
# secret key itself; PAYSTACK_WEBHOOK_SECRET is only for deployments that
# rotate a separate value in. Point the webhook at
# POST {API}/api/v1/webhooks/paystack in the Paystack dashboard.
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# Where Paystack returns the customer after payment. Defaults to the first
# entry in FRONTEND_URLS, which is the storefront by convention.
STOREFRONT_URL=http://localhost:3000

# Unrouted — see config/services.php. The README paired Stripe with USD; the
# brand document does not mention it, and PaymentGatewayFactory no longer
# resolves to it. Kept so the settings panel keeps reporting honestly.
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

YANGO_API_KEY=
YANGO_API_BASE_URL=

DHL_API_KEY=
DHL_API_BASE_URL=

# Feature 8 SMS. **Without these the SMS half falls back to LogSmsChannel**,
# which writes each message to the log instead of sending it — the feature
# still runs end to end, it just does not text anyone, and the admin
# notifications panel reports `sms_channel: log_only` rather than implying
# otherwise. Email needs no credential in development: MAIL_MAILER=log above
# renders the real template to the log.
# The request shape in FishAfricaSmsService is written from the README's
# description and has never been run against the live API — expect to correct
# it when keys land, and sandbox-test first (Ghana delivery rates unverified).
FISH_AFRICA_APP_ID=
FISH_AFRICA_APP_SECRET=
FISH_AFRICA_BASE_URL=https://api.letsfish.africa

GA4_MEASUREMENT_ID=
GA4_API_SECRET=

VITE_APP_NAME="${APP_NAME}"
