NUXT_PUBLIC_API_BASE=http://localhost:8000/api/v1
NUXT_PUBLIC_WHATSAPP_NUMBER=
NUXT_PUBLIC_GA_MEASUREMENT_ID=

# Geo (announcement-bar flag). All optional — defaults work in dev.
# Signs the geo cache cookie; set a stable random value in production.
NUXT_GEO_SECRET=
# IP geolocation provider; `{ip}` is substituted with the connecting address.
NUXT_GEO_LOOKUP_ENDPOINT=https://ipwho.is/{ip}
# Set to `false` when Node is exposed directly, with no proxy/CDN in front.
NUXT_GEO_TRUST_PROXY=true
NUXT_PUBLIC_GEO_FALLBACK_COUNTRY=GH
